# 이 파일을 .env 로 복사해 값을 넣는다 (이 파일에는 절대 키를 쓰지 않는다).
# srhbroker 는 현재 폴더 → 저장소 루트 → SRHBROKER_HOME 순으로 .env 를 찾고, 이미 설정된 환경 변수가 우선한다.
# 또는 Windows 사용자 환경 변수로 지정한다.
# PowerShell: [Environment]::SetEnvironmentVariable("TYPESAFE_API_KEY", "<키>", "User")
TYPESAFE_API_KEY=

# 브로커 데이터 디렉터리 (기본값: %USERPROFILE%\.srhbroker)
# SRHBROKER_HOME=
